# ==========================================================
# AI Dental Receptionist — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Default: local SQLite file (zero-setup, used by this scaffold).
# In production, point this at a real PostgreSQL instance and
# swap backend/src/db/index.js for a pg-backed adapter (see README).
DATABASE_URL=./data/clinic.db
# Example for Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/dental_clinic

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- AI Agent ----
# Choose your provider: "anthropic" (default) or "groq"
AI_PROVIDER=anthropic

# Used when AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-6

# Used when AI_PROVIDER=groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Voice Providers (optional — Web Speech API is used by default) ----
# Set these to enable a production-grade STT/TTS provider instead of the
# browser's built-in Web Speech API. Leave blank to use the free default.
VOICE_PROVIDER=browser
STT_API_KEY=
TTS_API_KEY=
VOICE_PROVIDER_API_KEY=

# ---- Notifications ----
EMAIL_API_KEY=
EMAIL_FROM=appointments@smiledentalclinic.example

# WhatsApp is architected via NotificationService but not wired to a
# live provider by default. Fill these in when you're ready to enable it.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# ---- Google Calendar (optional) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
